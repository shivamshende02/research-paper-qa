
# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

# Application environment (development/production)
APP_ENV=development

# Application logging level
LOG_LEVEL=INFO

# ==========================================
# LLM PROVIDER CONFIGURATION
# ==========================================

# Groq API key (obtain from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq model identifier
GROQ_MODEL=your_groq_model_id_here

# ==========================================
# LOCAL MODEL CONFIGURATION
# ==========================================

# Local model inference endpoint
LOCAL_ENDPOINT_URL=http://localhost:8000

# ==========================================
# EMBEDDING CONFIGURATION
# ==========================================

# HuggingFace embedding model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ==========================================
# VECTOR DATABASE CONFIGURATION
# ==========================================

# Qdrant connection URL
QDRANT_URL=http://localhost:6333

# Qdrant collection name
QDRANT_COLLECTION=research_papers

# ==========================================
# CACHE CONFIGURATION
# ==========================================

# Redis connection URL (optional)
REDIS_URL=redis://localhost:6379/0


# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vaani_db
POSTGRES_USER=vaani_user
POSTGRES_PASSWORD=your_postgres_password

MISTRAL_API_KEY=your_api_key
MISTRAL_MODEL=mistral-small-latest